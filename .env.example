# Optional: used only by the desktop-local controller
MEET_URL=

# SoundCard device indexes; default system output loopback and microphone
AUDIO_DEVICE_INDICES=0,1

# Password required to open the Streamlit app (also set in Streamlit Cloud secrets)
Password=

# Supabase login + cloud sync (Project settings > API). Also add to Streamlit secrets.
SUPABASE_URL=https://chadfjurseefihbioecx.supabase.co
SUPABASE_ANON_KEY=
# Used only by sync_meeting.py (optional; prompted if empty)
SYNC_EMAIL=
SYNC_PASSWORD=

# Hugging Face token for pyannote diarization after accepting model terms
HF_TOKEN=

# Optional overrides. With OLLAMA_API_KEY, defaults are Ollama Cloud and glm-5.3-flash.
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Optional: this account sees every user's meetings and who recorded them.
# Everyone else only sees their own recordings.
ADMIN_EMAIL=


# Meeting bot worker (run bot_worker.py on a PC/server, never in the app)
SUPABASE_SERVICE_KEY=
BOT_MAX_MINUTES=180

# Transcription (optional). Defaults: large-v3-turbo on NVIDIA GPU, small on CPU; language auto-detected per segment.
# Hosts with GPU need: pip install nvidia-cublas-cu12 nvidia-cudnn-cu12
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# WHISPER_LANGUAGE=uk

# Quality extras (optional)
# WHISPER_VOCABULARY=Python,GitHub Copilot,YourCompany   # names/terms; also one per line in vocabulary.txt
# AUDIO_CLEANUP=0                 # disable high-pass + noise reduction (pip install noisereduce enables noise reduction)
# TRANSCRIPT_LLM_CORRECTION=0     # disable the Ollama spelling-correction pass

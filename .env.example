# Optional: used only by the desktop-local controller
MEET_URL=

# SoundCard device indexes; default system output loopback and microphone
AUDIO_DEVICE_INDICES=0,1

# Password required to open the Streamlit app (also set in Streamlit Cloud secrets)
Password=

# Hugging Face token for pyannote diarization after accepting model terms
HF_TOKEN=

# Optional overrides. With OLLAMA_API_KEY, defaults are Ollama Cloud and glm-5.3-flash.
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Optional: used only by the desktop-local controller
MEET_URL=

# SoundCard device indexes; default system output loopback and microphone
AUDIO_DEVICE_INDICES=0,1

# Hugging Face token for pyannote diarization after accepting model terms
HF_TOKEN=

# Local Ollama defaults to 127.0.0.1; set a reachable HTTPS endpoint in hosted deployments
OLLAMA_HOST=
OLLAMA_API_KEY=
